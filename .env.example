# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# NOTE: Must begin with "jdbc:postgresql://".
# For local development connecting to Render: Use the External Database URL.
# Example: jdbc:postgresql://dpg-xxxxxxxx-a.oregon-postgres.render.com:5432/mydb_name
DB_URL=jdbc:postgresql://<HOST>:5432/<DATABASE_NAME>
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ==============================================================================
# Security & Auth Settings (If applicable)
# ==============================================================================
# Generate a secure 32+ character key for signing/encryption
# APP_SECRET_KEY=replace-with-a-random-secure-string